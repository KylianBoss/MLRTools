.DS_Store
.thumbs.db
node_modules

# Quasar core related directories
.quasar
/dist
/quasar.config.*.temporary.compiled*

# Cordova related directories and files
/src-cordova/node_modules
/src-cordova/platforms
/src-cordova/plugins
/src-cordova/www

# Capacitor related directories and files
/src-capacitor/www
/src-capacitor/node_modules

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln

# local .env files
.env.local*
.env

storage/*
# Migrations SQL/Sequelize suivent le schéma versionné dans database.js —
# elles doivent rester traçables dans git, contrairement au reste de
# storage/ (secrets, PDFs générés, cache). Git ne peut pas ré-inclure un
# sous-dossier d'un dossier déjà exclu en bloc, d'où storage/* ci-dessus
# (exclut le contenu, pas le dossier) plutôt que storage/.
!storage/migrations/

*.md
